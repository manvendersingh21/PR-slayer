# AgentGate Configuration

# === Offline Mode (default) ===
# No keys needed - runs against local git with canned data

# === Hybrid Mode ===
# Real Jev decisions, offline everything else
JEV_API_KEY=jv_live_your_key_here
# OR
TYPESAFE_API_KEY=jv_live_your_key_here

# === Live Mode ===
# Real GitHub, CodeRabbit, Jev, and LLM

# GitHub (required for live mode)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=manvendersingh21/PR-slayer

# Jev Decision API (get key from thejevai.com)
JEV_API_KEY=jv_live_your_key_here

# LLM for code generation (choose one)
OPENAI_API_KEY=sk-your_key_here
# OR
ANTHROPIC_API_KEY=sk-ant-your_key_here

# === Optional ===
PORT=8000
REPO_PATH=/workspace
